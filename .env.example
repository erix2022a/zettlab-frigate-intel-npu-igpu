# Copy this file to .env. NEVER commit .env to GitHub.
# All identities, addresses, and credentials below are PLACEHOLDERS.
# Dummy MQTT broker host, port 1883 in Frigate config
FRIGATE_MQTT_HOST=192.168.1.10
FRIGATE_MQTT_USER=REPLACE_WITH_MQTT_USERNAME
FRIGATE_MQTT_PASSWORD=REPLACE_WITH_MQTT_PASSWORD

# Replace with your camera credentials and IP address.
# Percent-encode URL-reserved characters in usernames/passwords.
FRIGATE_CAMERA_RTSP_URL=rtsp://CAMERA_USER:CAMERA_PASSWORD@192.168.1.20:554/h264Preview_01_main

# More DUMMY addresses for the setup guide (not used by Compose directly):
# Zettlab Frigate web UI: https://192.168.1.30:8971
# Home Assistant web UI: http://192.168.1.40:8123
# Internal Ollama API: http://ollama:11434 (on frigate_default Docker network)
